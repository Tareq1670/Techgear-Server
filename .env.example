# Server
PORT=5000
NODE_ENV=development
# Next.js (Better-Auth) origin; backend fetches JWKS from {CLIENT_URL}/api/auth/jwks to verify JWTs
CLIENT_URL=http://localhost:3000

# Database (Supabase / Neon / any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ImageBB
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Dev/test only — lets protected routes work WITHOUT a live Better-Auth client.
# Ignored when NODE_ENV=production. In dev/test, sending the token below (or an
# "x-dev-user" JSON header like {"sub":"u1","email":"a@b.c","role":"ADMIN"})
# bypasses remote JWKS verification and attaches the configured mock identity.
DEV_MOCK_TOKEN=dev-token
DEV_MOCK_USER_ID=dev-user-id
DEV_MOCK_EMAIL=dev@techgear.test
DEV_MOCK_ROLE=ADMIN
